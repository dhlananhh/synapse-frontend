# This is an example file. Copy this to .env.local for development.
# In the future, this will hold the base URL for the backend API.

# Base URL for general API requests (if you use a gateway or proxy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth service endpoint (used for login, refresh, etc.)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4000/api/auth

# User service endpoint (used for user profile, etc.)
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:4002/api/users

# (Optional) Other microservice endpoints
NEXT_PUBLIC_COMMUNITY_SERVICE_URL=http://localhost:4003/api/communities

NEXT_PUBLIC_REPORT_SERVICE_URL=http://localhost:4003/api/reports

NEXT_PUBLIC_UPLOAD_SERVICE_URL=http://localhost:4003/api/uploads

NEXT_PUBLIC_POST_SERVICE_URL=http://localhost:4003/api/posts

NEXT_PUBLIC_COMMENT_SERVICE_URL=http://localhost:4003/api/comments

NEXT_PUBLIC_MESSAGE_SERVICE_URL=http://localhost:4005/api/

NEXT_PUBLIC_FEED_SERVICE_URL=http://localhost:4004/api/feed

NEXT_PUBLIC_MESSAGE_SERVER_URL=http://localhost:4005

NEXT_PUBLIC_NOTIFICATION_SERVER_URL=http://localhost:4001

# (Optional) Feature flags, analytics, etc.
# NEXT_PUBLIC_FEATURE_X_ENABLED=true
